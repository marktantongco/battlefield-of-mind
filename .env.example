# WordPress Configuration
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-site.wordpress.com/wp-json/wp/v2

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Stripe Configuration (for donations)
