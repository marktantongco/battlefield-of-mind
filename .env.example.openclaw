# OpenClaw Moltbot Environment Variables
# Copy this to .env on your server or local development

# WordPress Configuration
WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json

# AI API Keys
OPENAI_API_KEY=sk-...

# OpenClaw Configuration
# Get your API key from: https://openclaw.ai
OPENCLAW_API_KEY=your-openclaw-api-key-here
OPENCLAW_API_URL=https://api.openclaw.ai

# Site Configuration
SITE_URL=https://yourdomain.com
SITE_NAME=My AI Blog
SITE_DESCRIPTION=AI-powered content platform with OpenClaw Moltbot

# Monetization (Optional)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Node Environment
NODE_ENV=production
