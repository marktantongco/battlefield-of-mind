\\n  if (!post) {\\n    notFound()\\n  }\\n\\n  const readingTime = calculateReadingTime(post.content)\\n  const jsonLd = generateBlogPostingJsonLd({\\n    title: post.title,\\n    excerpt: post.excerpt,\\n    url: `${process.env.NEXT_PUBLIC_SITE_URL}/blog/${post.slug}`,\\n    imageUrl: post.featuredImage?.url,\\n    publishDate: post.date,\\n    authorName: post.author.name,\\n    keywords: post.tags,\\n  })\\n\\n  // Example: Check if post has affiliate links or is sponsored\\n  const hasAffiliateLinks = post.content.includes('affiliate') || post.tags.some(tag => \\n    tag.toLowerCase().includes('review') || tag.toLowerCase().includes('product')\\n  )\\n  const sponsorship = {\\n    isSponsored: false, // Set based on your post metadata\\n  }\\n\\n  return (\\n    <>\\n      <script\\n        type=\\\"application/ld+json\\\"\\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLd) }}\\n      />\\n      \\n      <div className=\\\"min-h-screen flex flex-col\\\">\\n        <Header />\\n        \\n        <main className=\\\"flex-grow\\\">\\n          <article className=\\\"container mx-auto px-4 py-8 max-w-4xl\\\">\\n            {/* Featured Image */}\\n            {post.featuredImage && (\\n              <div className=\\\"relative w-full h-[400px] rounded-lg overflow-hidden mb-8\\\">\\n                <Image\\n                  src={post.featuredImage.url}\\n                  alt={post.featuredImage.alt}\\n                  fill\\n                  className=\\\"object-cover\\\"\\n                  priority\\n                />\\n              </div>\\n            )}\\n\\n            {/* Categories */}\\n            <div className=\\\"flex flex-wrap gap-2 mb-4\\\">\\n              {post.categories.map((category) => (\\n                <Badge key={category} variant=\\\"secondary\\\">\\n                  {category}\\n                </Badge>\\n              ))}\\n            </div>\\n\\n            {/* Title */}\\n            <h1 className=\\\"text-4xl md:text-5xl font-bold mb-4\\\">{post.title}</h1>\\n\\n            {/* Meta Information */}\\n            <div className=\\\"flex flex-wrap items-center gap-4 text-muted-foreground mb-6 pb-6 border-b\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                {post.author.avatar && (\\n                  <Image\\n                    src={post.author.avatar}\\n                    alt={post.author.name}\\n                    width={40}\\n                    height={40}\\n                    className=\\\"rounded-full\\\"\\n                  />\\n                )}\\n                <span className=\\\"font-medium\\\">{post.author.name}</span>\\n              </div>\\n              <div className=\\\"flex items-center gap-1\\\">\\n                <Calendar className=\\\"h-4 w-4\\\" />\\n                <span>{formatDate(post.date)}</span>\\n              </div>\\n              <div className=\\\"flex items-center gap-1\\\">\\n                <Clock className=\\\"h-4 w-4\\\" />\\n                <span>{readingTime} min read</span>\\n              </div>\\n            </div>\\n\\n            {/* Sponsored Badge */}\\n            <SponsoredBadge sponsorship={sponsorship} />\\n\\n            {/* Content */}\\n            <div \\n              className=\\\"prose prose-lg dark:prose-invert max-w-none mb-8\\\"\\n              dangerouslySetInnerHTML={{ __html: post.content }}\\n            />\\n\\n            {/* Affiliate Disclosure */}\\n            {hasAffiliateLinks && <AffiliateDisclosure />}\\n\\n            {/* Tags */}\\n            {post.tags.length > 0 && (\\n              <div className=\\\"mb-8\\\">\\n                <h3 className=\\\"text-sm font-semibold mb-3\\\">Tags:</h3>\\n                <div className=\\\"flex flex-wrap gap-2\\\">\\n                  {post.tags.map((tag) => (\\n                    <Badge key={tag} variant=\\\"outline\\\">\\n                      #{tag}\\n                    </Badge>\\n                  ))}\\n                </div>\\n              </div>\\n            )}\\n\\n            {/* Donation Widget */}\\n            <div className=\\\"my-12\\\">\\n              <DonationWidget />\\n            </div>\\n\\n            {/* Share Buttons */}\\n            <div className=\\\"border-t pt-8\\\">\\n              <h3 className=\\\"text-lg font-semibold mb-4 flex items-center gap-2\\\">\\n                <Share2 className=\\\"h-5 w-5\\\" />\\n                Share this article\\n              </h3>\\n              <div className=\\\"flex gap-2\\\">\\n                {/* Add social share buttons here */}\\n                <p className=\\\"text-sm text-muted-foreground\\\">\\n                  Share buttons coming soon...\\n                </p>\\n              </div>\\n            </div>\\n          </article>\\n        </main>\\n\\n        <Footer />\\n      </div>\\n    </>\\n  )\\n}\\n\"}", "tool_call_id": "toolu_bdrk_01XaQmuq9ZV5gVpogoEdKgNa", "id": null, "provider_details": null, "part_kind": "tool-call"}
