2026-02-04 07:13:21.775 | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'expand_code_chunks', 'gen_ai.tool.call.id': 'toolu_bdrk_01ReoZFE4GG7D98vBZwB5ZKt', 'tool_arguments': '{"file_path": "src/app/battlefield/page.tsx", "patterns": ["useState","handleComplete"]}', 'logfire.msg': 'running tool: expand_code_chunks', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'tool_response': 'Successfully expanded code chunks in src/app/battlefield/page.tsx:\n\n````tsx\n   0 "use client";\n   1 \n   2 import { useState } from "react";\n   3 import { motion, AnimatePresence } from "framer-motion";\n   4 \n   5 export default function BattlefieldPage() {\n   6   const [currentSection, setCurrentSection] = useState(0);\n   7   const [showCelebration, setShowCelebration] = useState(false);\n   8   const [culpritThought, setCulpritThought] = useState("");\n   9   const [reframedThought, setReframedThought] = useState("");\n  10   const [cleanupStep, setCleanupStep] = useState({\n  11     apologize: "",\n  12     impact: "",\n  13     promise: "",\n  14     recommit: ""\n  15   });\n  16   const [missionProclamation, setMissionProclamation] = useState("");\n  17   const [fundOfKnowledge, setFundOfKnowledge] = useState("");\n  18 \n  19   const sections = [\n  20     {\n  21       title: "The Battlefield of the Mind",\n  22       icon: "🧠",\n  23       color: "from-amber-500 to-orange-600",\n  24       content: (\n  25         <>\n  26           <p className="text-lg leading-relaxed mb-6">\n  27             Personal conflict is primarily fought in the <span className="font-bold">"battlefield of the mind,"</span> where entrenched patterns of thinking, or <span className="font-bold">"strongholds,"</span> lead to suspicion, doubt, and fear. To resolve these conflicts effectively, you must move from a <span className="font-bold">"victim" mentality</span>—blaming external circumstances—to an <span className="font-bold">"owner" mentality</span>, taking 100% accountability for your impact on t\n  28           </p>\n  29           \n  30           <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6 mb-8">\n  31             <h3 className="text-xl font-bold text-amber-300 mb-4 flex items-center">\n  32               <span className="mr-2">🔍</span> Identify the Internal Root\n  33             </h3>\n  34             <p className="text-slate-300 mb-4">\n  35               Most conflicts are fueled by <span className="font-semibold">"wilderness mentalities"</span> such as blame-shifting or deterministic thinking. These mentalities trap you in cycles of frustration because they deny you the power to change the solution.\n  36             </p>\n  37             <div className="space-y-4">\n  38               <div>\n  39                 <label className="block text-slate-400 mb-2">What "culprit thought" is currently occupying your mind?</label>\n  40                 <input\n  41                   type="text"\n  42                   value={culpritThought}\n  43                   onChange={(e) => setCulpritThought(e.target.value)}\n  44                   placeholder="e.g., \'I\'m damaged goods\', \'My past defines me\'"\n  45                   className="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent"\n  46                 />\n  47               </div>\n  48               <div>\n  49                 <label className="block text-slate-400 mb-2">Reframe this thought with truth:</label>\n  50                 <input\n  51                   type="text"\n  52                   value={reframedThought}\n  53                   onChange={(e) => setReframedThought(e.target.value)}\n  54                   placeholder="e.g., \'I am fearfully and wonderfully made\', \'My future is built on hope\'"\n  55                   className="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent"\n  56                 />\n  57               </div>\n  58             </div>\n  59           </div>\n  60           \n  61           <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n  62             <h3 className="text-xl font-bold text-amber-300 mb-4 flex items-center">\n  63               <span className="mr-2">🔄</span> Shift from Content to Process\n  64             </h3>\n  65             <div className="grid md:grid-cols-2 gap-6">\n  66               <div>\n  67                 <h4 className="font-bold text-red-400 mb-2 flex items-center">\n  68                   <span className="mr-2">❌</span> Avoid "You" Statements\n  69                 </h4>\n  70                 <ul className="space-y-2 text-slate-300">\n  71                   <li>• "You&apos;re being ridiculous"</li>\n  72                   <li>• "You always do this"</li>\n  73                   <li>• "You never listen"</li>\n  74                 </ul>\n  75                 <p className="text-slate-400 mt-3 italic">These act as a "wagging finger" and evoke defensiveness.</p>\n  76               </div>\n  77               <div>\n  78                 <h4 className="font-bold text-emerald-400 mb-2 flex items-center">\n  79                   <span className="mr-2">✅</span> Replace with "I" Statements\n  80                 </h4>\n  81                 <ul className="space-y-2 text-slate-300">\n  82                   <li>• "I&apos;m having difficulty understanding"</li>\n  83                   <li>• "I feel concerned when..."</li>\n  84                   <li>• "I need clarity on..."</li>\n  85                 </ul>\n  86                 <p className="text-slate-400 mt-3 italic">These foster safety and open dialogue.</p>\n  87               </div>\n  88             </div>\n  89           </div>\n  90         </>\n  91       )\n  92     },\n  93     {\n  94       title: "The Cleanup Process",\n  95       icon: "🧼",\n  96       color: "from-blue-500 to-cyan-600",\n  97       content: (\n  98         <>\n  99           <p className="text-lg leading-relaxed mb-6">\n 100             To repair a relationship where damage has been done, use this structured four-step process. This moves the conflict from a <span className="font-bold">"broken record"</span> of blame to a <span className="font-bold">"winning story"</span> of shared recovery.\n 101           </p>\n 102           \n 103           <div className="space-y-6">\n 104             {[{\n 105               step: 1,\n 106               title: "Apologize",\n 107               placeholder: "I sincerely apologize for...",\n 108               key: "apologize"\n 109             }, {\n 110               step: 2,\n 111               title: "Own the Impact",\n 112               placeholder: "I take 100% accountability for the effect my actions had on you...",\n 113               key: "impact"\n 114             }, {\n 115               step: 3,\n 116               title: "Make a Promise",\n 117               placeholder: "In the future, I will...",\n 118               key: "promise"\n 119             }, {\n 120               step: 4,\n 121               title: "Recommit",\n 122               placeholder: "Our relationship is important to me because...",\n 123               key: "recommit"\n 124             }].map((item) => (\n 125               <div key={item.step} className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n 126                 <div className="flex items-start mb-4">\n 127                   <div className="flex-shrink-0 w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center mr-3 mt-1">\n 128                     <span className="font-bold text-blue-300">{item.step}</span>\n 129                   </div>\n 130                   <h3 className="text-xl font-bold text-blue-300">{item.title}</h3>\n 131                 </div>\n 132                 <textarea\n 133                   value={cleanupStep[item.key as keyof typeof cleanupStep]}\n 134                   onChange={(e) => setCleanupStep(prev => ({...prev, [item.key]: e.target.value}))}\n 135                   placeholder={item.placeholder}\n 136                   className="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 min-h-[100px] text-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"\n 137                 />\n 138               </div>\n 139             ))}\n 140           </div>\n 141           \n 142           <div className="mt-8 p-6 bg-gradient-to-r from-blue-900/30 to-cyan-900/30 border border-blue-800/50 rounded-xl">\n 143             <p className="italic text-slate-300">\n 144               <span className="font-bold">Remember:</span> Focus entirely on the <span className="font-semibold">impact</span>, not your intent. Avoid explaining "good intentions" as this rarely repairs damage. Immediately move toward the promise for the future.\n 145             </p>\n 146           </div>\n 147         </>\n 148       )\n 149     },\n 150     {\n 151       title: "The Openly Mended Paradigm",\n 152       icon: "✨",\n 153       color: "from-purple-500 to-pink-600",\n 154       content: (\n 155         <>\n 156           <p className="text-lg leading-relaxed mb-6">\n 157             True resolution does not mean the absence of scars; it means <span className="font-bold">wholeness is found in the transparency</span> with which those scars are carried. By engaging <span className="font-bold">"eye-to-eye and heart-to-heart"</span> regarding shared brokenness, you dismantle the hierarchies that prevent authentic connection.\n 158           </p>\n 159           \n 160           <div className="grid md:grid-cols-2 gap-8 mb-10">\n 161             <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n 162               <h3 className="text-xl font-bold text-purple-300 mb-4 flex items-center">\n 163                 <span className="mr-2">💎</span> Your Scars as Bridges\n 164               </h3>\n 165               <p className="text-slate-300 mb-4">\n 166                 Instead of hiding your history, view your recovery process as a <span className="font-semibold">"fund of knowledge"</span> that provides you with unique authority to lead others. Your scars become bridges for authentic connection with those still in the "battlefield".\n 167               </p>\n 168               <div>\n 169                 <label className="block text-slate-400 mb-2">What past struggle has become your greatest bridge to others?</label>\n 170                 <input\n 171                   type="text"\n 172                   value={fundOfKnowledge}\n 173                   onChange={(e) => setFundOfKnowledge(e.target.value)}\n 174                   placeholder="e.g., \'My journey through addiction gives me empathy for others\'"\n 175                   className="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"\n 176                 />\n 177               </div>\n 178             </div>\n 179             \n 180             <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n 181               <h3 className="text-xl font-bold text-pink-300 mb-4 flex items-center">\n 182                 <span className="mr-2">🛡️</span> Deconstruct Strongholds\n 183               </h3>\n 184               <p className="text-slate-300 mb-4">\n 185                 Practice meta-cognition by <span className="font-semibold">"thinking about what you are thinking about"</span> to identify "culprit" thoughts that label you as permanently flawed. Firmly reject the lie that your past determines your future.\n 186               </p>\n 187               <div className="space-y-3">\n 188                 <div className="flex items-center">\n 189                   <div className="w-6 h-6 rounded-full bg-red-500/20 flex items-center justify-center mr-3">\n 190                     <span>❌</span>\n 191                   </div>\n 192                   <span className="text-slate-400">"I am damaged goods"</span>\n 193                 </div>\n 194                 <div className="flex items-center">\n 195                   <div className="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center mr-3">\n 196                     <span>✅</span>\n 197                   </div>\n 198                   <span className="text-slate-300">"I am fearfully and wonderfully made"</span>\n 199                 </div>\n 200                 <div className="flex items-center">\n 201                   <div className="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center mr-3">\n 202                     <span>✅</span>\n 203                   </div>\n 204                   <span className="text-slate-300">"My past does not define my future"</span>\n 205                 </div>\n 206               </div>\n 207             </div>\n 208           </div>\n 209           \n 210           <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n 211             <h3 className="text-xl font-bold text-purple-300 mb-4 flex items-center">\n 212               <span className="mr-2">🗣️</span> Verbalize Your Winning Story\n 213             </h3>\n 214             <p className="text-slate-300 mb-4">\n 215               Gird your mind by proclaiming foundational truths about your identity as a <span className="font-semibold">"victor"</span>. This proclamation acts as a call to action for your mission.\n 216             </p>\n 217             <textarea\n 218               value={missionProclamation}\n 219               onChange={(e) => setMissionProclamation(e.target.value)}\n 220               placeholder="My winning story: I am not defined by my past struggles, but empowered by my recovery to build institutions that heal others..."\n 221               className="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 min-h-[120px] text-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"\n 222             />\n 223           </div>\n 224         </>\n 225       )\n 226     },\n 227     {\n 228       title: "Your Mission Architecture",\n 229       icon: "🚀",\n 230       color: "from-emerald-500 to-teal-600",\n 231       content: (\n 232         <>\n 233           <p className="text-lg leading-relaxed mb-6">\n 234             Your unique journey provides the architectural blueprint for building institutions that address the <span className="font-bold">"uncommunicated messages"</span> that lead to broken relationships. This shifts your goal from acquiring tangible corporate achievements to becoming someone truly valuable who empowers others to shine.\n 235           </p>\n 236           \n 237           <div className="space-y-8">\n 238             <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n 239               <h3 className="text-xl font-bold text-emerald-300 mb-4 flex items-center">\n 240                 <span className="mr-2">🧠</span> AI as Your Vocabulary of Hope\n 241               </h3>\n 242               <div className="grid md:grid-cols-2 gap-6">\n 243                 {[\n 244                   {\n 245                     title: "Meta-Cognitive Monitoring",\n 246                     desc: "AI prompts users to \'think about what they are thinking about,\' identifying \'culprit\' thoughts like \'I am damaged goods\'"\n 247                   },\n 248                   {\n 249                     title: "Narrative Reframing",\n 250                     desc: "AI helps reframe history of relapse into a \'testimony of recovery\' where users are \'openly mended\'"\n 251                   },\n 252                   {\n 253                     title: "Positive Scripting",\n 254                     desc: "AI provides a \'litmus test\' to distinguish lies from truth, replacing negative patterns with foundational proclamations"\n 255                   },\n 256                   {\n 257                     title: "Victory Scripts",\n 258                     desc: "AI generates personalized scripts that gird the mind for action: \'I\'m not going there!\'"\n 259                   }\n 260                 ].map((item, index) => (\n 261                   <div key={index} className="bg-slate-800/40 border border-slate-700/50 rounded-lg p-4">\n 262                     <h4 className="font-bold text-emerald-300 mb-2">{item.title}</h4>\n 263                     <p className="text-slate-300">{item.desc}</p>\n 264                   </div>\n 265                 ))}\n 266               </div>\n 267             </div>\n 268             \n 269             <div className="bg-slate-900/70 border border-slate-700 rounded-xl p-6">\n 270               <h3 className="text-xl font-bold text-teal-300 mb-4 flex items-center">\n 271                 <span className="mr-2">📜</span> Draft Your Mission Proclamation\n 272               </h3>\n 273               <p className="text-slate-300 mb-4">\n 274                 Craft a powerful statement that incorporates your history as a source of strength for your AI recovery institution:\n 275               </p>\n 276               <textarea\n 277                 value={missionProclamation}\n 278                 onChange={(e) => setMissionProclamation(e.target.value)}\n 279                 placeholder="Mission Proclamation: Through my journey of recovery, I architect AI-driven institutions that transform broken records into winning stories. My scars are not liabilities—they are the blueprint for healing others. I build not from a place of perfection, but from the powerful position of being openly mended."\n 280                 className="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 min-h-[150px] text-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"\n 281               />\n 282             </div>\n 283             \n 284             <div className="bg-gradient-to-r from-emerald-900/30 to-teal-900/30 border border-emerald-800/50 rounded-xl p-6">\n 285               <h3 className="text-xl font-bold text-emerald-300 mb-3">Why This Matters</h3>\n 286               <p className="text-slate-300">\n 287                 By leveraging your analytical engineering background and AI focus, you create digital environments where vulnerability becomes a bridge for shared wholeness. Your mission transforms uncommunicated messages of brokenness into technical architectures for human empowerment.\n 288               </p>\n 289             </div>\n 290           </div>\n 291         </>\n 292       )\n 293     }\n 294   ];\n 295 \n 296   const handleComplete = () => {\n 297     setShowCelebration(true);\n 298     setTimeout(() => setShowCelebration(false), 6000);\n 299   };\n 300 \n 301   const celebrationVariants = {\n 302     initial: { scale: 0, opacity: 0 },\n 303     animate: { \n 304       scale: 1, \n 305       opacity: 1,\n 306       transition: { type: "spring", damping: 5, stiffness: 100 }\n 307     },\n 308     exit: { \n 309       scale: 0, \n 310       opacity: 0,\n 311       transition: { duration: 0.5 }\n 312     }\n 313   };\n 314 \n 315   const confettiVariants = {\n 316     initial: { y: "-100%", opacity: 1 },\n 317     animate: {\n 318       y: "100%",\n 319       opacity: [1, 0.7, 0],\n 320       transition: {\n 321         duration: 3,\n 322         repeat: Infinity,\n 323         repeatType: "loop" as const,\n 324         ease: "linear"\n 325       }\n 326     }\n 327   };\n 328 \n 329   return (\n 330     <div className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 text-slate-50 font-sans selection:bg-amber-500/20">\n 331       {/* Decorative elements */}\n 332       <div className="fixed inset-0 overflow-hidden pointer-events-none">\n 333         <div className="absolute -top-16 -right-16 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl"></div>\n 334         <div className="absolute -bottom-24 -left-24 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl"></div>\n 335         <div className="absolute top-1/4 left-1/3 w-48 h-48 bg-purple-500/10 rounded-full blur-2xl"></div>\n 336         <div className="absolute bottom-1/3 right-1/4 w-56 h-56 bg-emerald-500/10 rounded-full blur-2xl"></div>\n 337       </div>\n 338       \n 339       <div className="relative max-w-5xl mx-auto px-6 py-12 md:py-16">\n 340         {/* Progress Navigation */}\n 341         <div className="flex justify-between mb-12">\n 342           {sections.map((section, index) => (\n 343             <motion.button\n 344               key={index}\n 345               whileHover={{ y: -5 }}\n 346               onClick={() => setCurrentSection(index)}\n 347               className={`flex flex-col items-center p-3 rounded-xl transition-all ${\n 348                 currentSection === index \n 349                   ? `bg-gradient-to-br ${section.color} text-slate-900 shadow-lg`\n 350                   : \'bg-slate-800/50 hover:bg-slate-800\'\n 351               }`}\n 352             >\n 353               <div className={`w-10 h-10 rounded-full flex items-center justify-center mb-2 ${\n 354                 currentSection === index ? \'bg-white\' : \'bg-slate-700\'\n 355               }`}>\n 356                 <span className={`text-xl ${currentSection === index ? \'text-slate-900\' : \'text-slate-300\'}`}>\n 357                   {section.icon}\n 358                 </span>\n 359               </div>\n 360               <span className="text-sm font-medium text-center max-w-[120px]">\n 361                 {section.title}\n 362               </span>\n 363             </motion.button>\n 364           ))}\n 365         </div>\n 366 \n 367         {/* Current Section Content */}\n 368         <AnimatePresence mode="wait">\n 369           <motion.div\n 370             key={currentSection}\n 371             initial={{ opacity: 0, x: 20 }}\n 372             animate={{ opacity: 1, x: 0 }}\n 373             exit={{ opacity: 0, x: -20 }}\n 374             transition={{ duration: 0.3 }}\n 375             className="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-3xl p-8 md:p-10 shadow-2xl mb-12"\n 376           >\n 377             <div className="flex items-start mb-8">\n 378               <div className={`flex-shrink-0 w-16 h-16 rounded-2xl bg-gradient-to-br ${sections[currentSection].color} flex items-center justify-center mr-6`}>\n 379                 <span className="text-3xl">{sections[currentSection].icon}</span>\n 380               </div>\n 381               <h1 className="text-3xl md:text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-amber-500">\n 382                 {sections[currentSection].title}\n 383               </h1>\n 384             </div>\n 385             \n 386             <div className="prose prose-slate max-w-none">\n 387               {sections[currentSection].content}\n 388             </div>\n 389           </motion.div>\n 390         </AnimatePresence>\n 391 \n 392         {/* Navigation Controls */}\n 393         <div className="flex justify-between items-center mb-20">\n 394           <motion.button\n 395             whileHover={{ x: -5 }}\n 396             whileTap={{ scale: 0.95 }}\n 397             onClick={() => currentSection > 0 && setCurrentSection(prev => prev - 1)}\n 398             disabled={currentSection === 0}\n 399             className={`px-6 py-3 rounded-xl font-medium text-lg transition-all ${\n 400               currentSection === 0\n 401                 ? \'bg-slate-800 text-slate-500 cursor-not-allowed\'\n 402                 : \'bg-slate-800/70 hover:bg-slate-700 text-slate-300\'\n 403             }`}\n 404           >\n 405             ← Previous\n 406           </motion.button>\n 407           \n 408           {currentSection < sections.length - 1 ? (\n 409             <motion.button\n 410               whileHover={{ scale: 1.05 }}\n 411               whileTap={{ scale: 0.95 }}\n 412               onClick={() => setCurrentSection(prev => prev + 1)}\n 413               className="px-8 py-4 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-slate-900 font-bold text-lg rounded-xl shadow-lg shadow-amber-500/30 transition-all"\n 414             >\n 415               Next Section →\n 416             </motion.button>\n 417           ) : (\n 418             <motion.button\n 419               whileHover={{ scale: 1.05 }}\n 420               whileTap={{ scale: 0.95 }}\n 421               onClick={handleComplete}\n 422               className="px-8 py-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-slate-900 font-bold text-lg rounded-xl shadow-lg shadow-emerald-500/30 transition-all"\n 423             >\n 424               I&apos;VE RECALIBRATED →\n 425             </motion.button>\n 426           )}\n 427         </div>\n 428 \n 429         {/* Final Call to Action */}\n 430         {currentSection === sections.length - 1 && (\n 431           <motion.div \n 432             initial={{ opacity: 0, y: 20 }}\n 433             animate={{ opacity: 1, y: 0 }}\n 434             transition={{ delay: 0.3 }}\n 435             className="text-center max-w-3xl mx-auto p-8 bg-slate-900/50 border border-slate-800 rounded-2xl mb-16"\n 436           >\n 437             <h2 className="text-3xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-rose-400">\n 438               Your Transformation Is Complete\n 439             </h2>\n 440             <p className="text-xl text-slate-300 mb-8">\n 441               You&apos;ve moved from a <span className="font-bold">"broken record"</span> of conflict to a <span className="font-bold">"winning story"</span> of shared recovery. Your scars are now bridges. Your past is now power.\n 442             </p>\n 443             <p className="text-lg text-slate-400 italic max-w-2xl mx-auto">\n 444               "Know that you are created to be more than enough. Special when you are born." \n 445               <br />\n 446               <span className="text-slate-500">— This isn&apos;t just a text—it&apos;s your new foundation.</span>\n 447             </p>\n 448           </motion.div>\n 449         )}\n 450       </div>\n 451 \n 452       {/* Celebration Overlay */}\n 453       <AnimatePresence>\n 454         {showCelebration && (\n 455           <motion.div \n 456             variants={celebrationVariants}\n 457             initial="initial"\n 458             animate="animate"\n 459             exit="exit"\n 460             className="fixed inset-0 bg-gradient-to-br from-slate-900/95 to-slate-950/95 z-50 flex flex-col items-center justify-center p-4"\n 461           >\n 462             {/* Confetti */}\n 463             <div className="absolute inset-0 overflow-hidden pointer-events-none">\n 464               {[...Array(50)].map((_, i) => (\n 465                 <motion.div\n 466                   key={i}\n 467                   variants={confettiVariants}\n 468                   initial="initial"\n 469                   animate="animate"\n 470                   style={{\n 471                     position: "absolute",\n 472                     left: `${Math.random() * 100}%`,\n 473                     top: `${Math.random() * 100}%`,\n 474                     width: `${Math.random() * 10 + 5}px`,\n 475                     height: `${Math.random() * 10 + 5}px`,\n 476                     backgroundColor: ["#f59e0b", "#3b82f6", "#8b5cf6", "#ec4899", "#10b981", "#0ea5e9"][\n 477                       Math.floor(Math.random() * 6)\n 478                     ],\n 479                     borderRadius: Math.random() > 0.5 ? "50%" : "0",\n 480                     transform: `rotate(${Math.random() * 360}deg)`,\n 481                     opacity: Math.random() * 0.7 + 0.3\n 482                   }}\n 483                 />\n 484               ))}\n 485             </div>\n 486             \n 487             <div className="text-center relative z-10 max-w-2xl mx-auto px-4">\n 488               <motion.div\n 489                 initial={{ scale: 0 }}\n 490                 animate={{ scale: 1 }}\n 491                 transition={{ type: "spring", damping: 5, stiffness: 100, delay: 0.3 }}\n 492                 className="w-40 h-40 rounded-full bg-gradient-to-br from-amber-500 to-emerald-500 flex items-center justify-center mx-auto mb-8 shadow-xl shadow-amber-500/50 border-4 border-slate-900"\n 493               >\n 494                 <span className="text-7xl">✨</span>\n 495               </motion.div>\n 496               \n 497               <motion.h2 \n 498                 initial={{ opacity: 0, y: 20 }}\n 499                 animate={{ opacity: 1, y: 0 }}\n 500                 transition={{ delay: 0.5 }}\n 501                 className="text-5xl md:text-7xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-emerald-400"\n 502               >\n 503                 YOU ARE RECALIBRATED!\n 504               </motion.h2>\n 505               \n 506               <motion.p\n 507                 initial={{ opacity: 0 }}\n 508                 animate={{ opacity: 1 }}\n 509                 transition={{ delay: 0.7 }}\n 510                 className="text-2xl text-slate-300 mb-10 max-w-2xl mx-auto"\n 511               >\n 512                 Your winning story has begun. Your scars are now bridges. Your mission is clear.\n 513               </motion.p>\n 514               \n 515               <motion.div\n 516                 initial={{ opacity: 0 }}\n 517                 animate={{ opacity: 1 }}\n 518                 transition={{ delay: 0.9 }}\n 519                 className="flex justify-center"\n 520               >\n 521                 <div className="w-32 h-1.5 bg-gradient-to-r from-amber-500 to-emerald-500 rounded-full overflow-hidden">\n 522                   <motion.div \n 523                     initial={{ width: "100%" }}\n 524                     animate={{ width: 0 }}\n 525                     transition={{ duration: 5, ease: "linear" }}\n 526                     className="h-full bg-white"\n 527                   />\n 528                 </div>\n 529               </motion.div>\n 530               \n 531               <motion.div\n 532                 initial={{ opacity: 0 }}\n 533                 animate={{ opacity: 1 }}\n 534                 transition={{ delay: 1.2 }}\n 535                 className="mt-12 p-6 bg-slate-900/50 border border-slate-800 rounded-2xl max-w-2xl mx-auto"\n 536               >\n 537                 <p className="text-xl font-bold mb-4">\n 538                   "I am not defined by my past struggles, but empowered by my recovery to build institutions that heal others."\n 539                 </p>\n 540                 <p className="text-lg text-slate-400 italic">\n 541                   — Your Mission Proclamation\n 542                 </p>\n 543               </motion.div>\n 544             </div>\n 545           </motion.div>\n 546         )}\n 547       </AnimatePresence>\n 548     </div>\n 549   );\n 550 }\n 551 \n````'}
