ot/app/ssl/ && cd /root/app && docker compose restart nginx\\\" | crontab -\\n\\necho \\\"\\\"\\necho \\\"\u2705 SSL certificate installed successfully!\\\"\\necho \\\"\\\"\\necho \\\"Your site is now available at:\\\"\\necho \\\"  https://$DOMAIN\\\"\\necho \\\"\\\"\\necho \\\"Certificate auto-renewal is configured.\\\"\\necho \\\"\\\"\\n\"}", "tool_call_id": "toolu_bdrk_01ABun6gD3znfeZq3ndnqKfu", "id": null, "provider_details": null, "part_kind": "tool-call"}
