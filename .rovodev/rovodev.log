   = [hcloud_ssh_key.default.id]\n  firewall_ids = [hcloud_firewall.web.id]\n\n  user_data = templatefile("${path.module}/cloud-init.yaml", {\n    docker_compose = file("${path.module}/../docker-compose.yml")\n    nginx_conf     = file("${path.module}/../nginx.conf")\n    env_vars       = {\n      WORDPRESS_API_URL           = var.wordpress_api_url\n      OPENAI_API_KEY             = var.openai_api_key\n      ANTHROPIC_API_KEY          = var.anthropic_api_key\n      STRIPE_PUBLISHABLE_KEY     = var.stripe_publishable_key\n      SITE_URL                   = var.site_url\n      SITE_NAME                  = var.site_name\n      SITE_DESCRIPTION           = var.site_description\n    }\n  })\n\n  labels = {\n    environment = "production"\n    service     = "clawbot"\n  }\n}\n\n# Volume for persistent data\nresource "hcloud_volume" "storage" {\n  name      = "clawbot-storage"\n  size      = 10\n  server_id = hcloud_server.clawbot.id\n  automount = true\n  format    = "ext4"\n}\n\noutput "server_ip" {\n  value       = hcloud_server.clawbot.ipv4_address\n  description = "The public IP address of the server"\n}\n\noutput "server_name" {\n  value       = hcloud_server.clawbot.name\n  description = "The name of the server"\n}\n', 'tool_response': 'Successfully replaced code in terraform/main.tf:\n\n--- terraform/main.tf\n+++ terraform/main.tf\n@@ -13,7 +13,7 @@\n \n # SSH Key\n resource "hcloud_ssh_key" "default" {\n-  name       = "clawbot-key"\n+  name       = "openclaw-moltbot-key"\n   public_key = file(var.ssh_public_key_path)\n }\n \n'}
