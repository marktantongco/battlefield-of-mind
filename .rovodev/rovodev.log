escription>\\n      </CardHeader>\\n      <CardContent className=\\"space-y-4\\">\\n        <div className=\\"grid grid-cols-2 md:grid-cols-4 gap-2\\">\\n          {DONATION_AMOUNTS.map((amount) => (\\n            <Button\\n              key={amount.value}\\n              variant={selectedAmount === amount.value ? \'default\' : \'outline\'}\\n              onClick={() => {\\n                setSelectedAmount(amount.value)\\n                setCustomAmount(\'\')\\n              }}\\n              className=\\"flex flex-col h-auto py-3\\"\\n            >\\n              <Coffee className=\\"h-4 w-4 mb-1\\" />\\n              <span className=\\"font-bold\\">{amount.label}</span>\\n              <span className=\\"text-xs opacity-70\\">{amount.description}</span>\\n            </Button>\\n          ))}\\n        </div>\\n\\n        <div className=\\"space-y-2\\">\\n          <label className=\\"text-sm font-medium\\">Or enter custom amount (₱)</label>\\n          <input\\n            type=\\"number\\"\\n            min=\\"10\\"\\n            placeholder=\\"Enter amount\\"\\n            className=\\"w-full h-10 rounded-md border border-input bg-background px-3 py-2\\"\\n            value={customAmount}\\n            onChange={(e) => {\\n              setCustomAmount(e.target.value)\\n              setSelectedAmount(null)\\n            }}\\n          />\\n        </div>\\n\\n        <Button onClick={handleDonate} className=\\"w-full\\" size=\\"lg\\">\\n          <Heart className=\\"mr-2 h-4 w-4\\" />\\n          Donate Now\\n        </Button>\\n\\n        <p className=\\"text-xs text-center text-muted-foreground\\">\\n          Secure payment via Stripe • Your support keeps this content free for everyone\\n        </p>\\n      </CardContent>\\n    </Card>\\n  )\\n}\\n"}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}
