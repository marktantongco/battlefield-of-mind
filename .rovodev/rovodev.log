ai-blog-platform.git app || true\n  - cd /root/app\n  - cp /root/.env .env\n  - cp /root/docker-compose.yml docker-compose.yml\n  - cp /root/nginx.conf nginx.conf\n  \n  # Start services\n  - docker compose pull\n  - docker compose up -d\n  \n  # Set up auto-updates\n  - echo "0 2 * * * cd /root/app && git pull && docker compose pull && docker compose up -d" | crontab -\n\nfinal_message: "Clawbot deployment complete! System ready after $UPTIME seconds"\n', 'tool_response': 'Successfully replaced code in terraform/cloud-init.yaml:\n\n--- terraform/cloud-init.yaml\n+++ terraform/cloud-init.yaml\n@@ -57,4 +57,4 @@\n   # Set up auto-updates\n   - echo "0 2 * * * cd /root/app && git pull && docker compose pull && docker compose up -d" | crontab -\n \n-final_message: "Clawbot deployment complete! System ready after $UPTIME seconds"\n+final_message: "OpenClaw Moltbot deployment complete! System ready after $UPTIME seconds"\n'}
