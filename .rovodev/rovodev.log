ar.openai_api_key\\n      ANTHROPIC_API_KEY          = var.anthropic_api_key\\n      STRIPE_PUBLISHABLE_KEY     = var.stripe_publishable_key\\n      SITE_URL                   = var.site_url\\n      SITE_NAME                  = var.site_name\\n      SITE_DESCRIPTION           = var.site_description\\n    }\\n  })\\n\\n  labels = {\\n    environment = \\"production\\"\\n    service     = \\"clawbot\\"\\n  }\\n}\\n\\n# Volume for persistent data\\nresource \\"hcloud_volume\\" \\"storage\\" {\\n  name      = \\"clawbot-storage\\"\\n  size      = 10\\n  server_id = hcloud_server.clawbot.id\\n  automount = true\\n  format    = \\"ext4\\"\\n}\\n\\noutput \\"server_ip\\" {\\n  value       = hcloud_server.clawbot.ipv4_address\\n  description = \\"The public IP address of the server\\"\\n}\\n\\noutput \\"server_name\\" {\\n  value       = hcloud_server.clawbot.name\\n  description = \\"The name of the server\\"\\n}\\n"}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}
